# Copy this file to `.env` (same folder, project root) and fill in your real
# key. `.env` is gitignored — it must never be committed.
#
# This key is used from Dart for the Places API (nearby pins) and Directions
# API (walking routes) HTTP calls. See android/app/src/main/AndroidManifest.xml
# for the separate key entry the native Google Maps SDK needs to render tiles.
MAPS_API_KEY=your_google_maps_api_key_here
