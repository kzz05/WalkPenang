{
  "version": 8,
  "name": "WalkPenang Sand",
  "metadata": {
    "walkpenang:note": "Map & GPS module basemap. Palette is the shared design-token set from lib/theme/app_theme.dart — see CLAUDE.md section 12.9. Edit this file and re-run upload_style.py rather than editing in Studio, so the style stays reviewable in git."
  },
  "sources": {
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "sprite": "mapbox://sprites/mapbox/streets-v12",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "center": [100.3288, 5.4141],
  "zoom": 16,
  "pitch": 55,
  "bearing": 0,
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#FFF3EA"
      }
    },
    {
      "id": "landuse-built",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": [
        "match",
        ["get", "class"],
        ["hospital", "school", "airport", "commercial_area", "industrial", "sand", "rock"],
        true,
        false
      ],
      "paint": {
        "fill-color": "#F5DCC7",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": [
        "match",
        ["get", "class"],
        ["park", "grass", "pitch", "garden", "wood", "scrub", "agriculture", "cemetery"],
        true,
        false
      ],
      "paint": {
        "fill-color": "#CBE3BE",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse_overlay",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": {
        "fill-color": "#CBE3BE",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "#CFE3DC"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "minzoom": 10,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#CFE3DC",
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          10, 0.8,
          18, 8
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 11,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary", "street", "street_limited"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#111111",
        "line-opacity": 0.12,
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          11, 2,
          16, 13,
          20, 36
        ]
      }
    },
    {
      "id": "road-fill",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 11,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary", "street", "street_limited"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          11, 1,
          16, 9.5,
          20, 29
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        [
          "match",
          ["get", "class"],
          ["path", "pedestrian", "track", "service"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#F5DCC7",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          13, 0.6,
          16, 3.5,
          20, 11
        ]
      }
    },
    {
      "id": "building-extrusion",
      "type": "fill-extrusion",
      "source": "composite",
      "source-layer": "building",
      "minzoom": 14,
      "filter": [
        "all",
        ["==", ["geometry-type"], "Polygon"],
        ["==", ["get", "extrude"], "true"]
      ],
      "paint": {
        "fill-extrusion-color": "#EBC5A8",
        "fill-extrusion-vertical-gradient": true,
        "fill-extrusion-opacity": 0.92,
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14, 0,
          15.5, ["min", ["*", ["get", "height"], 1.3], 70]
        ],
        "fill-extrusion-base": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14, 0,
          15.5, ["get", "min_height"]
        ]
      }
    },
    {
      "id": "settlement-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "minzoom": 8,
      "maxzoom": 15,
      "filter": [
        "match",
        ["get", "class"],
        ["settlement", "settlement_subdivision"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 11,
          14, 15
        ],
        "text-letter-spacing": 0.06,
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#111111",
        "text-opacity": 0.55,
        "text-halo-color": "#FFF3EA",
        "text-halo-width": 1.4
      }
    }
  ]
}
