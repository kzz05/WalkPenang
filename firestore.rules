rules_version = '2';

// WalkPenang Firestore security rules (NFR-04 — Data Protection).
//
// firebase.json has always pointed at this file, but until now it did not
// exist: the rules lived only in the Firebase console, unversioned. That is
// how the reward module's permission-denied broke without anyone noticing —
// see the users/ block below.
//
// Deploy with:
//   firebase deploy --only firestore:rules --project walkpenang-5cefb

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- Tourist profile and everything beneath it -----------------------
    //
    // The {document=**} suffix is load-bearing. Firestore rules do NOT
    // cascade into subcollections: a bare `match /users/{userId}` grants the
    // profile document alone, which is why reading the profile worked while
    // the reward dashboard returned PERMISSION_DENIED — its badges live one
    // level down.
    //
    // Covers:
    //   users/{uid}                          profile + cumulative reward totals
    //   users/{uid}/user_badges/{badgeId}    badges this tourist has earned
    //   users/{uid}/points_ledger/{checkInId} award history, keyed for idempotency
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ---- Badge catalogue -------------------------------------------------
    //
    // Shared reference data, not per-tourist: the definitions every gallery
    // renders. Readable by any signed-in tourist; never written from a
    // client, since letting a device edit badge criteria would let it mint
    // its own achievements. Seed it from the console or an admin SDK script.
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Check-ins -------------------------------------------------------
    //
    // Written by the Walking & Carbon module on arrival; the reward module
    // only reads them and stamps `rewardProcessed` so points are awarded
    // once. That write path does not exist yet, so this rule is provisional:
    // it assumes the document carries a `userId` field, which is what
    // CheckInResult.userId implies. Revisit when Module 4 lands its write.
    //
    // create is deliberately not update: a tourist may record a check-in but
    // must not be able to rewrite its distance afterwards and farm points.
    //
    // transportMode must be one of the known ids. Only 'walking' earns points
    // (see RewardPoints.forCheckIn), and TransportMode.fromId falls back to
    // 'walking' for anything it does not recognise — a fallback that is right
    // for pre-existing records but would otherwise let any unknown string mint
    // points. Absent is still allowed: check-ins written before modes existed
    // carry no such field and were all walks.
    match /check_ins/{checkInId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && (!('transportMode' in request.resource.data.keys())
                        || request.resource.data.transportMode
                           in ['walking', 'driving', 'publicTransport']);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    // Mode is fixed at creation. Allowing it to change would
                    // let a car journey be rewritten as a walk after the fact.
                    && request.resource.data.get('transportMode', 'walk')
                       == resource.data.get('transportMode', 'walk');
      allow delete: if false;
    }

    // ---- Place ratings and reviews ---------------------------------------
    //
    // This collection holds NO place content — no name, address, coordinates
    // or photos. Only the place id (as the document id) plus WalkPenang's own
    // aggregates. Place details are fetched live from the Places API, which is
    // both why they would go stale here and why storing them would breach
    // Google Maps Platform Terms 3.2.3(b): a place id may be cached
    // indefinitely, its content only for 30 days.
    //
    //   places/{placeId}                    ratingSum, ratingCount, reviewCount
    //   places/{placeId}/reviews/{reviewId} authorUid, authorName, rating, body
    //
    // The aggregate is writable by signed-in tourists because submitting a
    // review updates it in the same transaction, and Firestore rules cannot
    // express "only via a transaction that also creates a review". The bounds
    // below are what stops that being a free-for-all: counts may only ever
    // increase, and by one at a time, so a client cannot mint a five-star
    // average for a place it dislikes. Tightening this into a Cloud Function
    // (client writes the review, a trigger recomputes the aggregate) is the
    // proper fix and is worth doing before any public release.
    match /places/{placeId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.ratingCount == 1
                    && request.resource.data.ratingSum >= 1
                    && request.resource.data.ratingSum <= 5;

      allow update: if isSignedIn()
                    && request.resource.data.ratingCount
                       == resource.data.ratingCount + 1
                    && request.resource.data.ratingSum
                       >= resource.data.ratingSum + 1
                    && request.resource.data.ratingSum
                       <= resource.data.ratingSum + 5;

      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if isSignedIn();

        // Create only, never update or delete: a rating already folded into
        // the aggregate above must not be silently rewritten afterwards, or
        // the average stops matching the reviews listed under it. Bounds are
        // enforced here rather than trusted from the client — the UI's 1-5
        // star widget is not a security control.
        allow create: if isSignedIn()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Saved places (users/{uid}/favorites/{placeId}) need no rule of their own
    // — the users/{userId}/{document=**} match above already covers them, and
    // they too store an id and nothing else.

    // Anything not matched above is denied. Add collections explicitly as
    // other modules start writing.
  }
}
