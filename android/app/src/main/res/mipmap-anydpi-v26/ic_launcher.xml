<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0+ draws the launcher icon on a 108dp canvas and masks it into
     whatever shape the launcher uses (circle, squircle, teardrop). Without
     this, the legacy ic_launcher.png is shrunk inside a white blob instead of
     filling the mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
