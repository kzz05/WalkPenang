# Copy this file to `.env` (same folder, project root) and fill in your real
# keys. `.env` is gitignored — it must never be committed.
#
# Used from Dart for the Places API (nearby pins) and Directions API (walking
# routes) HTTP calls. Since the switch to Mapbox for rendering, this key is no
# longer used by any native SDK — it is Dart-side only.
MAPS_API_KEY=your_google_maps_api_key_here

# Public Mapbox token (starts with `pk.`). Used by the renderer to fetch tiles
# and the custom Studio style. Read in main.dart via MapboxOptions.setAccessToken.
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# NOTE — the *secret* Mapbox download token (starts with `sk.`, scope
# DOWNLOADS:READ) does NOT go here. It is build-time only and belongs in
# ~/.gradle/gradle.properties as:
#
#   MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_token_here
#
# Without it the Android build fails with a 401 on a com.mapbox.* artifact.
# See android/build.gradle.kts.
