# Copy this file to `.env` (same folder, project root) and fill in your real
# keys. `.env` is gitignored — it must never be committed.
#
# These keys are used from Dart over HTTP. See
# android/app/src/main/AndroidManifest.xml for the separate key entry the
# native Google Maps SDK needs to render tiles.

# Map & GPS module: Places API (nearby pins) and Directions API (routes).
# Read by lib/services/map_service.dart.
MAPS_API_KEY=your_google_maps_api_key_here

# Discovery module: Places API (New) search, details and photos.
# Read by lib/services/google_places_service.dart.
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
